import { generateText } from "ai";
import { anthropic } from "@ai-sdk/anthropic";
import { broadcastStore } from "@/lib/broadcast-store";
import { NextRequest } from "next/server";

export async function POST(req: NextRequest) {
  const { text } = await req.json();

  if (!text?.trim()) {
    return Response.json({ error: "No text provided" }, { status: 400 });
  }

  try {
    const { text: translated } = await generateText({
      // Uses ANTHROPIC_API_KEY from .env.local.
      // Claude Haiku is fast and cheap — perfect for real-time translation.
      model: anthropic("claude-haiku-4-5-20251001"),
      system:
        "You are a real-time church sermon translator. " +
        "Translate the given English text to Ukrainian accurately and naturally. " +
        "Preserve the tone — formal, respectful, and faithful to Christian preaching style. " +
        "Return ONLY the translated text, nothing else.",
      prompt: text,
    });

    // Push to all connected attendees via SSE
    broadcastStore.broadcast(translated);

    return Response.json({ translated });
  } catch (error) {
    console.error("[translate]", error);
    return Response.json({ error: "Translation failed" }, { status: 500 });
  }
}
