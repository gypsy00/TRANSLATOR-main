<file path="lib/broadcast-store.ts">
// In-memory store for SSE subscribers.
// Works perfectly for a single church session (one server instance).
// For multi-region Vercel deploy, swap with Upstash Redis pub/sub later.

type Handler = (text: string) => void;

const handlers = new Set<Handler>();

export const broadcastStore = {
  subscribe(fn: Handler) {
    handlers.add(fn);
  },
  unsubscribe(fn: Handler) {
    handlers.delete(fn);
  },
  broadcast(text: string) {
    handlers.forEach((fn) => fn(text));
  },
  get listenerCount() {
    return handlers.size;
  },
};
