"use client";

import { useState, useEffect, useRef, useCallback } from "react";
import Link from "next/link";

type Caption = { text: string; ts: number };

export default function ListenPage() {
  const [captions, setCaptions] = useState<Caption[]>([]);
  const [connected, setConnected] = useState(false);
  const bottomRef = useRef<HTMLDivElement>(null);
  const wakeLockRef = useRef<WakeLockSentinel | null>(null);

  // Keep attendee's phone awake during the service
  const requestWakeLock = useCallback(async () => {
    try {
      if ("wakeLock" in navigator) {
        wakeLockRef.current = await navigator.wakeLock.request("screen");
      }
    } catch {
      // Not critical
    }
  }, []);

  useEffect(() => {
    requestWakeLock();

    const es = new EventSource("/api/stream");

    es.onopen = () => setConnected(true);

    es.onmessage = (event) => {
      try {
        const { text, ts } = JSON.parse(event.data);
        setCaptions((prev) => [...prev.slice(-99), { text, ts }]);
      } catch {
        // ignore
      }
    };

    es.onerror = () => {
      setConnected(false);
    };

    return () => {
      es.close();
      wakeLockRef.current?.release();
    };
  }, [requestWakeLock]);

  // Auto-scroll to latest caption
  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [captions]);

  const latestCaption = captions[captions.length - 1];

  return (
    <main className="min-h-screen bg-gray-950 text-white flex flex-col">
      {/* Header */}
      <header className="sticky top-0 z-10 bg-gray-950/90 backdrop-blur-md border-b border-gray-800/50 px-5 py-3 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Link href="/" className="text-gray-500 hover:text-white transition-colors text-sm">
            ←
          </Link>
          <span className="text-lg">🇺🇦</span>
          <div>
            <h1 className="font-semibold text-sm tracking-tight">Ukrainian</h1>
            <p className="text-[10px] text-gray-500">Live translation</p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <span
            className={`w-2 h-2 rounded-full ${connected ? "bg-green-400" : "bg-yellow-400 animate-pulse"}`}
          />
          <span className="text-xs text-gray-400">
            {connected ? "Live" : "Connecting…"}
          </span>
        </div>
      </header>

      {/* Captions feed */}
      <div className="flex-1 overflow-y-auto px-5 py-5">
        {captions.length === 0 ? (
          <div className="h-full flex flex-col items-center justify-center text-center gap-4 py-32">
            <div className="text-6xl opacity-40">🕊️</div>
            <div>
              <p className="text-gray-400 text-lg font-light">
                Waiting for the service to begin…
              </p>
              <p className="text-gray-600 text-sm mt-2">
                Captions will appear here in Ukrainian
              </p>
            </div>
            {connected && (
              <div className="flex items-center gap-2 mt-4 text-green-400/70">
                <span className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />
                <span className="text-xs">Connected — ready to receive</span>
              </div>
            )}
          </div>
        ) : (
          <div className="space-y-4">
            {/* Previous captions — smaller, faded */}
            {captions.slice(0, -1).map((c) => (
              <p
                key={c.ts}
                className="text-lg leading-relaxed text-gray-400 font-light"
              >
                {c.text}
              </p>
            ))}

            {/* Latest caption — prominent */}
            {latestCaption && (
              <p className="text-2xl leading-relaxed text-white font-normal animate-in fade-in duration-300">
                {latestCaption.text}
              </p>
            )}

            <div ref={bottomRef} />
          </div>
        )}
      </div>

      {/* Footer */}
      <footer className="px-5 py-3 border-t border-gray-800/50">
        <div className="flex items-center justify-between">
          <p className="text-gray-600 text-[10px]">
            {captions.length > 0
              ? `${captions.length} line${captions.length !== 1 ? "s" : ""} received`
              : "Keep this screen open"}
          </p>
          <p className="text-gray-700 text-[10px]">⛪ Church Translator</p>
        </div>
      </footer>
    </main>
  );
}
