<file path="app/api/stream/route.ts">
import { broadcastStore } from "@/lib/broadcast-store";

export const maxDuration = 300;
export const dynamic = "force-dynamic";

// SSE endpoint — attendees connect here to receive live Ukrainian captions.
export async function GET() {
  const encoder = new TextEncoder();

  let heartbeat: ReturnType<typeof setInterval>;
  let handler: (text: string) => void;

  const stream = new ReadableStream({
    start(controller) {
      // Send a keep-alive comment immediately so the browser knows it's connected
      controller.enqueue(encoder.encode(": connected\n\n"));

      handler = (text: string) => {
        try {
          const payload = JSON.stringify({ text, ts: Date.now() });
          controller.enqueue(encoder.encode(`data: ${payload}\n\n`));
        } catch {
          // Client disconnected — clean up
          cleanup();
        }
      };

      broadcastStore.subscribe(handler);

      // Heartbeat every 15s to prevent proxy/browser timeouts
      heartbeat = setInterval(() => {
        try {
          controller.enqueue(encoder.encode(": ping\n\n"));
        } catch {
          cleanup();
        }
      }, 15_000);
    },
    cancel() {
      // Called when the client disconnects
      cleanup();
    },
  });

  function cleanup() {
    clearInterval(heartbeat);
    if (handler) broadcastStore.unsubscribe(handler);
  }

  return new Response(stream, {
    headers: {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache, no-transform",
      Connection: "keep-alive",
      "X-Accel-Buffering": "no",
    },
  });
}
